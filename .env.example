# Brightloop Subscription Management System - Environment Configuration
# Built by Team Ripple

# Firebase Client Configuration (Frontend)
VITE_FIREBASE_API_KEY=AIzaSyDummyApiKeyForProductionOrEmulator
VITE_FIREBASE_AUTH_DOMAIN=brightloop-subs.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=brightloop-subs
VITE_FIREBASE_STORAGE_BUCKET=brightloop-subs.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_MEASUREMENT_ID=G-ABCDEF1234

# Firebase Emulators (true to route requests to local emulators)
VITE_USE_FIREBASE_EMULATOR=false
VITE_EMULATOR_AUTH_URL=http://localhost:9099
VITE_EMULATOR_FIRESTORE_HOST=localhost
VITE_EMULATOR_FIRESTORE_PORT=8080
VITE_EMULATOR_FUNCTIONS_PORT=5001

# App configuration
VITE_APP_NAME="Brightloop Subscription Management"
VITE_COMPANY_NAME="Brightloop Software"
VITE_DEFAULT_CURRENCY="INR"
VITE_CURRENCY_SYMBOL="₹"

